rules_version = '2';

// =============================================================================
// G-Set Patient Registry — Firestore security rules
// Mirrors the client-side capability matrix in firebase-config.js and enforces
// it server-side. Closed journeys are immutable. Only the Superuser manages
// reference data and reads the audit trail.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------
    function signedIn() { return request.auth != null; }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() { return profile().role; }
    function notDisabled() { return profile().disabled != true; }

    function isSuperuser() { return signedIn() && role() == 'Superuser'; }
    function canCapture() {
      return signedIn() && notDisabled() &&
        (role() == 'Superuser' || role() == 'ECC Personnel');
    }

    // ---- users -------------------------------------------------------------
    // A user may read their own profile; the Superuser may read/write all.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperuser());
      allow create, update, delete: if isSuperuser();
      // Allow a user to create their own profile only if it matches an existing
      // Superuser bootstrap is done via console; normal creation is Superuser-only.
    }

    // ---- patients ----------------------------------------------------------
    match /patients/{id} {
      allow read: if signedIn() && notDisabled();

      // Create a new (Active, open) journey.
      allow create: if canCapture()
        && request.resource.data.closed == false
        && request.resource.data.status == 'Active';

      // Update is only permitted to CLOSE an open journey — never to edit a
      // closed one. Once closed == true the record is permanently locked.
      allow update: if canCapture()
        && resource.data.closed == false
        && request.resource.data.closed == true
        && request.resource.data.status == 'Closed';

      allow delete: if false; // records are never deleted
    }

    // ---- reference data (Superuser writes, everyone signed-in reads) --------
    match /facilities/{id}   { allow read: if signedIn(); allow write: if isSuperuser(); }
    match /emsStations/{id}   { allow read: if signedIn(); allow write: if isSuperuser(); }
    match /districts/{id}     { allow read: if signedIn(); allow write: if isSuperuser(); }
    match /vehicles/{id}      { allow read: if signedIn(); allow write: if isSuperuser(); }
    match /meta/{id}          { allow read: if signedIn(); allow write: if isSuperuser(); }

    // ---- incident-number counters -----------------------------------------
    // Any capture-capable user increments the per-day counter inside a
    // transaction. No deletes.
    match /counters/{id} {
      allow read: if signedIn();
      allow create, update: if canCapture();
      allow delete: if false;
    }

    // ---- public executive dashboard snapshot -------------------------------
    // This single document holds ONLY aggregate operations data (counts,
    // averages, top facilities/stations/vehicles by volume, district totals,
    // trend arrays, alert counts). It contains NO patient-identifying data, so
    // it is the one place readable WITHOUT authentication — powering the public
    // command-centre view. Writes are restricted to signed-in, active staff,
    // who regenerate it from the private patient collection.
    match /dashboardMetrics/{id} {
      allow read: if true;
      allow write: if signedIn() && notDisabled();
    }

    // ---- audit logs --------------------------------------------------------
    // Append-only. Any signed-in user may write their own entries; only the
    // Superuser can read. Entries can never be edited or removed.
    match /auditLogs/{id} {
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow read: if isSuperuser();
      allow update, delete: if false;
    }
  }
}
