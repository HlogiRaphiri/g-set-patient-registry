rules_version = '2';

// =============================================================================
// G-Set Patient Registry — Firestore security rules
// Mirrors the client-side capability matrix in firebase-config.js and enforces
// it server-side. Once captured, a journey record is locked: the ONLY permitted
// changes are (a) closing an open journey, and (b) correcting the G-Set vehicle
// registration. Records are never deleted.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------
    function signedIn() { return request.auth != null; }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() { return profile().role; }
    function notDisabled() { return profile().disabled != true; }

    function isSuperuser() { return signedIn() && role() == 'Superuser'; }
    function canCapture() {
      return signedIn() && notDisabled() &&
        (role() == 'Superuser' || role() == 'ECC Personnel');
    }

    // The set of top-level keys that this update adds, removes, or changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // (a) A valid close transition: an open journey becomes closed, and ONLY the
    // close-related fields may change. The record's substantive data is untouched.
    function isCloseTransition() {
      return resource.data.closed == false
        && request.resource.data.closed == true
        && request.resource.data.status == 'Closed'
        && changedKeys().hasOnly(['closed', 'status', 'timeDelivered', 'closedBy', 'closedAt']);
    }

    // (b) A vehicle-registration correction: ONLY the vehicle field (plus its two
    // audit fields) may change, and the new value must be a non-empty string.
    function isVehicleEditOnly() {
      return changedKeys().hasOnly(['vehicle', 'vehicleUpdatedAt', 'vehicleUpdatedBy'])
        && request.resource.data.vehicle is string
        && request.resource.data.vehicle.size() > 0;
    }

    // ---- users -------------------------------------------------------------
    // A user may read their own profile; the Superuser may read/write all.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperuser());
      allow create, update, delete: if isSuperuser();
    }

    // ---- patients ----------------------------------------------------------
    match /patients/{id} {
      allow read: if signedIn() && notDisabled();

      // Create a new (Active, open) journey.
      allow create: if canCapture()
        && request.resource.data.closed == false
        && request.resource.data.status == 'Active';

      // After capture the record is locked. Only two updates are ever allowed:
      //   (a) closing an open journey, or
      //   (b) correcting ONLY the G-Set vehicle registration.
      // Every other field is immutable — including on already-closed records.
      allow update: if canCapture() && (isCloseTransition() || isVehicleEditOnly());

      // Records are never deleted, by anyone, through the rules.
      allow delete: if false;
    }

    // ---- reference data (Superuser writes, everyone signed-in reads) --------
    match /facilities/{id}   { allow read: if signedIn(); allow write: if isSuperuser(); }
    match /emsStations/{id}   { allow read: if signedIn(); allow write: if isSuperuser(); }
    match /districts/{id}     { allow read: if signedIn(); allow write: if isSuperuser(); }
    match /vehicles/{id}      { allow read: if signedIn(); allow write: if isSuperuser(); }
    match /meta/{id}          { allow read: if signedIn(); allow write: if isSuperuser(); }

    // ---- incident-number counters -----------------------------------------
    match /counters/{id} {
      allow read: if signedIn();
      allow create, update: if canCapture();
      allow delete: if false;
    }

    // ---- public executive dashboard snapshot -------------------------------
    match /dashboardMetrics/{id} {
      allow read: if true;
      allow write: if signedIn() && notDisabled();
    }

    // ---- audit logs --------------------------------------------------------
    match /auditLogs/{id} {
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow read: if isSuperuser();
      allow update, delete: if false;
    }
  }
}
